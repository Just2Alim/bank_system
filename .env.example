# Keep OPEN_BANKING_PROVIDER=demo until all four BCC application values are available.
OPEN_BANKING_PROVIDER=demo

# BCC sandbox only. Never commit real values.
BCC_CLIENT_ID=
BCC_CLIENT_SECRET=
BCC_APP_ID=

# financial or business-account-management.
#
# business-account-management 2.0 requires both OAuth and a customer x-client-token.
BCC_API_PRODUCT=financial
BCC_SCOPE=bcc.application.financial.api
BCC_TOKEN_URL=https://api-sandbox.bcc.kz/bcc/production/v2/oauth/token
BCC_API_BASE_URL=https://api-sandbox.bcc.kz/bcc/production/v1/financial
BCC_AUTH_CLIENT_BASE_URL=https://api-sandbox.bcc.kz/bcc/production/v1/auth-client
BCC_CLIENT_TOKEN=
BCC_PRODUCT_CODE=BusinessApi
