{
  "openapi": "3.1.0",
  "info": {
    "title": "Simulation Engine Internal API",
    "version": "1.0.0",
    "description": "Deterministic synthetic activity, virtual business time, API-based seed commands, and bounded failure controls. Wall-clock security and retry behavior is never governed by this clock."
  },
  "servers": [{"url": "http://simulation-engine:8080"}],
  "security": [{"operatorJwt": []}],
  "paths": {
    "/internal/v1/clock": {
      "get": {
        "operationId": "getVirtualClock",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}],
        "responses": {"200": {"description": "Current virtual business clock.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VirtualClock"}}}}}
      }
    },
    "/internal/v1/clock/pause": {
      "post": {
        "operationId": "pauseVirtualClock",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClockCommand"}}}},
        "responses": {"200": {"$ref": "#/components/responses/ClockResult"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/internal/v1/clock/resume": {
      "post": {
        "operationId": "resumeVirtualClock",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClockCommand"}}}},
        "responses": {"200": {"$ref": "#/components/responses/ClockResult"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/internal/v1/clock/rate": {
      "post": {
        "operationId": "setVirtualClockRate",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["commandId", "expectedVersion", "rate"],
                "properties": {
                  "commandId": {"type": "string", "pattern": "^SIM-CMD-[A-Z0-9-]{8,64}$"},
                  "expectedVersion": {"type": "integer", "minimum": 1},
                  "rate": {"type": "number", "minimum": 0.1, "maximum": 1000}
                }
              }
            }
          }
        },
        "responses": {"200": {"$ref": "#/components/responses/ClockResult"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/internal/v1/clock/advance": {
      "post": {
        "operationId": "advanceVirtualClock",
        "description": "Deterministically advances a paused clock for tests and demonstrations.",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["commandId", "expectedVersion", "seconds"],
                "properties": {
                  "commandId": {"type": "string", "pattern": "^SIM-CMD-[A-Z0-9-]{8,64}$"},
                  "expectedVersion": {"type": "integer", "minimum": 1},
                  "seconds": {"type": "integer", "minimum": 1, "maximum": 31536000}
                }
              }
            }
          }
        },
        "responses": {"200": {"$ref": "#/components/responses/ClockResult"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/internal/v1/runs": {
      "post": {
        "operationId": "startSimulationRun",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StartRunRequest"}}}},
        "responses": {"201": {"description": "Run started.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SimulationRun"}}}}, "200": {"description": "Idempotent replay.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SimulationRun"}}}}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/internal/v1/runs/{runId}": {
      "get": {
        "operationId": "getSimulationRun",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/RunId"}],
        "responses": {"200": {"description": "Run state.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SimulationRun"}}}}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/internal/v1/runs/{runId}/stop": {
      "post": {
        "operationId": "stopSimulationRun",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/RunId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["commandId"], "properties": {"commandId": {"type": "string", "pattern": "^SIM-CMD-[A-Z0-9-]{8,64}$"}}}}}
        },
        "responses": {"200": {"description": "Run stopped or idempotently already terminal.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SimulationRun"}}}}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/internal/v1/seed": {
      "post": {
        "operationId": "seedSyntheticEcosystem",
        "description": "Seeds through owner APIs; never writes another service database directly.",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SeedRequest"}}}},
        "responses": {"202": {"$ref": "#/components/responses/CommandResult"}, "200": {"$ref": "#/components/responses/CommandResult"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/internal/v1/failure-controls": {
      "post": {
        "operationId": "activateBoundedFailureControl",
        "description": "Creates an expiring simulator-only availability or latency control; it does not alter financial records.",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FailureControlRequest"}}}},
        "responses": {"201": {"description": "Control activated.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FailureControl"}}}}, "200": {"description": "Idempotent replay.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FailureControl"}}}}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"operatorJwt": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {
      "CorrelationId": {"name": "X-Correlation-ID", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^SIM-CORR-[A-Z0-9-]{8,64}$"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^SIM-IDEM-[A-Z0-9-]{8,96}$"}},
      "RunId": {"name": "runId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^SIM-RUN-[A-Z0-9-]{8,64}$"}}
    },
    "responses": {
      "ClockResult": {"description": "Updated virtual clock.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VirtualClock"}}}},
      "CommandResult": {"description": "Idempotent command receipt.", "content": {"application/json": {"schema": {"$ref": "../json-schema/common/command-receipt.v1.schema.json"}}}},
      "Error": {"description": "Safe error response.", "content": {"application/json": {"schema": {"$ref": "../json-schema/common/error.v1.schema.json"}}}}
    },
    "schemas": {
      "VirtualClock": {
        "type": "object",
        "additionalProperties": false,
        "required": ["simulationTime", "wallClockObservedAt", "status", "rate", "version"],
        "properties": {
          "simulationTime": {"type": "string", "format": "date-time"},
          "wallClockObservedAt": {"type": "string", "format": "date-time"},
          "status": {"type": "string", "enum": ["RUNNING", "PAUSED"]},
          "rate": {"type": "number", "minimum": 0.1, "maximum": 1000},
          "version": {"type": "integer", "minimum": 1}
        }
      },
      "ClockCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "expectedVersion"],
        "properties": {
          "commandId": {"type": "string", "pattern": "^SIM-CMD-[A-Z0-9-]{8,64}$"},
          "expectedVersion": {"type": "integer", "minimum": 1}
        }
      },
      "StartRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "seed", "targetRatePerMinute", "activityMix"],
        "properties": {
          "runId": {"type": "string", "pattern": "^SIM-RUN-[A-Z0-9-]{8,64}$"},
          "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "targetRatePerMinute": {"type": "integer", "minimum": 1, "maximum": 10000},
          "activityMix": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["INTERNAL_TRANSFER", "INTERBANK_RTGS", "INTERBANK_CLEARING", "MSMP", "QR", "CARD_PURCHASE", "ATM_WITHDRAWAL"]}
          }
        }
      },
      "SimulationRun": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "status", "seed", "generatedCount", "startedAt", "simulationTime"],
        "properties": {
          "runId": {"type": "string", "pattern": "^SIM-RUN-[A-Z0-9-]{8,64}$"},
          "status": {"type": "string", "enum": ["STARTING", "RUNNING", "STOPPING", "STOPPED", "COMPLETED", "FAILED"]},
          "seed": {"type": "integer", "minimum": 0},
          "generatedCount": {"type": "integer", "minimum": 0},
          "startedAt": {"type": "string", "format": "date-time"},
          "stoppedAt": {"type": ["string", "null"], "format": "date-time"},
          "simulationTime": {"type": "string", "format": "date-time"}
        }
      },
      "SeedRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seedId", "dataset", "openingPosition"],
        "properties": {
          "seedId": {"type": "string", "pattern": "^SIM-SEED-[A-Z0-9-]{8,64}$"},
          "dataset": {"type": "string", "enum": ["MINIMAL", "DEMO", "LOAD_TEST"]},
          "openingPosition": {"$ref": "../json-schema/common/money.v1.schema.json"}
        }
      },
      "FailureControlRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlId", "target", "kind", "durationSeconds"],
        "properties": {
          "controlId": {"type": "string", "pattern": "^SIM-FAIL-[A-Z0-9-]{8,64}$"},
          "target": {"type": "string", "enum": ["ORDA_CORE_ADAPTER", "NOMAD_BANK", "TENGRI_BANK", "ORDA_CARD", "NOMAD_CARD", "TENGRI_CARD", "NPP_ISO_GATEWAY", "NPP_SETTLEMENT", "OPERATIONS_CONSUMER"]},
          "kind": {"type": "string", "enum": ["ADDED_LATENCY", "TEMPORARY_UNAVAILABLE", "DROP_RESPONSE_AFTER_COMMIT"]},
          "latencyMilliseconds": {"type": "integer", "minimum": 1, "maximum": 30000},
          "durationSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      },
      "FailureControl": {
        "allOf": [
          {"$ref": "#/components/schemas/FailureControlRequest"},
          {
            "type": "object",
            "required": ["status", "activatedAt", "expiresAt"],
            "properties": {
              "status": {"type": "string", "enum": ["ACTIVE", "EXPIRED", "CANCELLED"]},
              "activatedAt": {"type": "string", "format": "date-time"},
              "expiresAt": {"type": "string", "format": "date-time"}
            }
          }
        ]
      }
    }
  }
}
