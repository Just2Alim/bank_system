{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-simulator.local/contracts/common/error.v1.schema.json",
  "title": "ErrorV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "timestamp", "trace_id", "details"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
      "examples": ["INSUFFICIENT_AVAILABLE_FUNDS"]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "examples": ["11111111111111111111111111111111"]
    },
    "request_id": {
      "type": "string",
      "pattern": "^SIM-REQ-[A-Z0-9-]{8,64}$"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
