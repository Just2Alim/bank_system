{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-simulator.local/contracts/common/health.v1.schema.json",
  "title": "ServiceHealthV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "status", "checkedAt"],
  "properties": {
    "service": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"type": "string", "enum": ["UP", "DEGRADED", "DOWN", "UNKNOWN"]},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
